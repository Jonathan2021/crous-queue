# DRAFT ONLY: exact public host, PostgreSQL version and approval are unresolved.
CQ_ENVIRONMENT=production
CQ_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_SECRET@127.0.0.1:5432/crous_queue_production
CQ_SESSION_SECRET=
CQ_IP_SECRET=
CQ_ADMIN_TOKEN=
CQ_ORIGIN=https://queue.example.invalid
CQ_SECURE_COOKIES=true
CQ_PORT=8000
# Same-host TLS proxy only (ADR-0009); never 0.0.0.0/0. Empty trusts no proxy.
CQ_TRUSTED_PROXIES=127.0.0.1
CQ_FORWARDED_HEADER=x-forwarded-for
CQ_NETWORK_ESTIMATE_CAP=2
CQ_NETWORK_HOURLY_LIMIT=120
